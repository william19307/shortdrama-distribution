# 复制为仓库根目录 .env，apps/api 与 Prisma 都会读取。
# 服务器、域名、对象存储均未定时，只通过环境变量切换，不要把真实密钥写进代码。

# PostgreSQL（docker compose 默认）
DATABASE_URL=postgresql://shortform:shortform@localhost:5432/shortform

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173
# 生产（NODE_ENV=production）必须是不少于 32 位、且不以 change-me 开头的随机串。开发环境可以留空，会用内置默认值。
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
NODE_ENV=development
# 演示种子。默认 true。Docker 启动不另设时也写入演示账号。设为 false 可跳过。已有账号的密码不会被重置。
SEED_DEMO=true
# 定时任务（Asia/Shanghai）。表达式填 off 可关掉这一条。JOBS_ENABLED=false 全部停用。测试环境不启动。
# DS-09：05:00 预警，未完成每 30 分钟再提醒，06:00 超时升级给主管。
# RV-12：审核 SLA。SLA_WARN_RATIO 到达比例发预警，到期算超时，SLA_DOUBLE_RATIO 算两倍超时。
# ST-02：01:00 按结算周期自动生成结算单。演示可 POST /api/admin/jobs/:name/run（管理员或运营主管）。
JOBS_ENABLED=true
CRON_TZ=Asia/Shanghai
CRON_DS01=0 0 * * *
CRON_DS09_WARN=0 5 * * *
MATCH_THRESHOLD=0.85
CRON_DS09_REPEAT=*/30 * * * *
CRON_DS09_ESCALATE=0 6 * * *
CRON_RV12=0 0,6,12,18 * * *
CRON_ST02=0 1 * * *
SLA_WARN_RATIO=0.8
SLA_DOUBLE_RATIO=2
# 默认 false：浏览器直传对象存储。本地没有 CORS、直传失败时改为 true，上传改走 API。读文件和缩略图仍用 PUBLIC_OBJECT_URL。
# 演示编排里的 MinIO 不支持桶 CORS 接口，compose 用 MINIO_API_CORS_ALLOW_ORIGIN=* 放行浏览器。
UPLOAD_VIA_API=false

# 对象存储。STORAGE_DRIVER=s3 走 S3 兼容接口（MinIO / 腾讯云 COS 均可）。
# 本地无 MinIO 时可临时设 STORAGE_DRIVER=memory（仅开发，进程内，重启即丢）。
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shortform
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123456
S3_FORCE_PATH_STYLE=true
# 发给浏览器的预签名和文件地址。API 在容器里用 S3_ENDPOINT=http://minio:9000 时，浏览器访问不到这个主机名。
# 演示把 MinIO 的 9000 映射到本机时写成 http://localhost:9000。不设则与 S3_ENDPOINT 相同。
PUBLIC_OBJECT_URL=http://localhost:9000
# 浏览器直传时预签名 URL 必须是浏览器能访问的地址。API 跑在宿主机、MinIO 映射 9000 时用 localhost。
# 切到腾讯云 COS 示例（路径风格通常关闭）：
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
# S3_BUCKET=your-bucket-appid
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# 前端开发服务器（Vite 代理到 API，一般不用改）
VITE_API_PROXY=http://localhost:3000
